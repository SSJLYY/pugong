// ---------------- 中文大数格式化 ----------------
function fmt(d) {
  if (!(d instanceof Decimal)) d = new Decimal(d);
  if (d.lt(10000)) return Math.floor(d.toNumber()).toLocaleString('zh-CN');
  const n = d.toNumber();
  // 到 1e44（载）；超过后走 break_infinity 科学计数法
  for (let i = CN_UNITS.length - 1; i >= 1; i--) {
    const [name, scale] = CN_UNITS[i];
    if (n >= scale && n < scale * 10000) {
      return (n / scale).toFixed(2) + name;
    }
  }
  if (n >= 1e44) return d.toString().slice(0, 12); // 兜底
  return Math.floor(n).toLocaleString('zh-CN');
}
function fmtPct(x) { return (x * 100).toFixed(1) + '%'; }

// ---------------- 装备渲染（M3） ----------------
function slotLabel(slot) {
  const m = { weapon:'武器', offhand:'副手', bow:'弓', head:'头', chest:'胸', legs:'腿', boots:'鞋', ring1:'戒1', ring2:'戒2', necklace:'项链' };
  return m[slot] || slot;
}
// 属性键 → 中文名 + 格式化
const STAT_LABEL = { PATK:'物攻', MATK:'魔攻', PDEF:'物防', MDEF:'魔防', maxHP:'生命', MP:'蓝量',
                     ASPD:'攻速', RNG:'射程', SPD:'移速', CRIT:'暴击', CRITD:'暴伤', ACC:'命中',
                     EVA:'闪避', REGEN:'回血', MREGEN:'回蓝', LIFESTEAL:'吸血', REGEN_PCT:'生命泉涌' };
function fmtStatVal(key, val, type) {
  const sign = val >= 0 ? '+' : '';
  if (key === 'REGEN_PCT') return '每秒回 ' + (val * 100).toFixed(0) + '% 生命上限';
  if (key === 'LIFESTEAL') return sign + (val * 100).toFixed(1) + '% 吸血';
  if (key === 'ASPD') return sign + val.toFixed(2) + ' 攻速';
  if (key === 'CRIT' || key === 'ACC' || key === 'EVA') return sign + (val * 100).toFixed(1) + '% ' + STAT_LABEL[key];
  if (key === 'CRITD') return sign + (val * 100).toFixed(0) + '% 暴伤';
  if (type === 'pct') return sign + (val * 100).toFixed(0) + '% ' + (STAT_LABEL[key] || key);
  return sign + (Number.isInteger(val) ? val : val.toFixed(1)) + ' ' + (STAT_LABEL[key] || key);
}
// 词条稀有度颜色
const RARITY_COLOR = { common:'#9a978c', uncommon:'#5cb87e', rare:'#4a9eff', epic:'#b366ff' };
// 装备底子摘要（如 +2物攻 +1射程）
function baseSummary(base) {
  return Object.keys(base || {}).map(k => fmtStatVal(k, base[k], 'flat')).join(' ');
}
// 词条行 HTML（含稀有度上色 + 副作用）
function affixHtml(a) {
  const c = RARITY_COLOR[a.rarity] || '#9a978c';
  let t = '<span style="color:' + c + '">' + a.name + ' ' + fmtStatVal(a.key, a.val, a.type) + '</span>';
  if (a.side) t += ' <span style="color:#a03a3a">' + fmtStatVal(a.side.key, a.side.val, 'pct') + '</span>';
  return t;
}
let equipRenderKey = -1;
function renderEquip() {
  // 每 100ms 的游戏 tick 不应重建按钮；装备数据实际变化时 invVersion（game.js 维护）才会 +1。
  const renderKey = invVersion;
  if (renderKey === equipRenderKey) return;
  equipRenderKey = renderKey;

  // 已装备区
  let eqHtml = '';
  for (const slot of EQUIP_SLOTS) {
    const item = S.equipped[slot];
    if (item) {
      const q = QUALITY[item.quality];
      const enh = 1 + (item.enhance || 0) * ENHANCE.statBonus;
      // 底子属性（含强化加成）
      const baseStats = Object.keys(item.base || {}).map(k => fmtStatVal(k, item.base[k] * enh, 'flat')).join(' ');
      const affs = (item.affixes || []).map(a => affixHtml(a)).join('<br>');
      eqHtml += '<div class="eq-slot" style="border-color:'+q.color+'">'+
        '<div class="eq-line1"><span class="eq-emoji">'+item.emoji+'</span>'+
        '<span class="eq-name" style="color:'+q.color+'">'+item.name+(item.enhance?'+'+item.enhance:'')+'</span>'+
        '<button class="eq-btn" data-unequip="'+slot+'">卸</button></div>'+
        '<div class="eq-base">'+baseStats+'</div>'+
        (affs?'<div class="eq-affs">'+affs+'</div>':'')+
        '</div>';
    } else {
      eqHtml += '<div class="eq-slot empty"><span class="eq-emoji">▢</span><span class="eq-name">'+slotLabel(slot)+'</span></div>';
    }
  }
  $('equippedSlots').innerHTML = eqHtml;
  // 背包区
  $('bagCount').textContent = S.equipBag.length + '/' + BAG_MAX;
  const bagEl = $('bagList');
  if (S.equipBag.length === 0) { bagEl.innerHTML = '<p class="empty-hint">击杀怪物掉落装备</p>'; return; }
  let bh = '';
  for (let i = 0; i < S.equipBag.length; i++) {
    const it = S.equipBag[i]; const q = QUALITY[it.quality];
    const enh = 1 + (it.enhance || 0) * ENHANCE.statBonus;
    const baseStats = Object.keys(it.base || {}).map(k => fmtStatVal(k, it.base[k] * enh, 'flat')).join(' ');
    const affs = (it.affixes || []).map(a => affixHtml(a)).join('<br>');
    bh += '<div class="bag-item" style="border-color:'+q.color+'">'+
      '<div class="bag-line1"><span class="bag-emoji">'+it.emoji+'</span>'+
      '<span class="bag-name" style="color:'+q.color+'">'+it.name+(it.enhance?'+'+it.enhance:'')+'</span>'+
      '<span class="bag-slot">'+slotLabel(it.slot)+'</span></div>'+
      '<div class="bag-base">'+baseStats+'</div>'+
      (affs?'<div class="bag-affs">'+affs+'</div>':'')+
      '<div class="bag-btns">'+
      '<button data-act="equip" data-idx="'+i+'">装</button>'+
      '<button data-act="enhance" data-idx="'+i+'">强化</button>'+
      '<button data-act="sell" data-idx="'+i+'">卖</button>'+
      '<button data-act="discard" data-idx="'+i+'">丢</button></div></div>';
  }
  bagEl.innerHTML = bh;
}

// ---------------- 技能/药剂渲染（M4） ----------------
let passiveRenderKey = '';
// 按钮/行引用缓存：构建一次，之后每 tick 直接更新，不重复 querySelector
const skillBtnMap = {};   // id -> { btn, cd }
const potRowMap = {};     // id -> { row, stock, use, buy }
function renderSkills() {
  // 被动列表只在学会/读档时变化。
  const passives = S.skills.passives || [];
  const nextPassiveKey = JSON.stringify(passives);
  if (nextPassiveKey !== passiveRenderKey) {
    passiveRenderKey = nextPassiveKey;
    let ph = '';
    if (passives.length === 0) {
      ph = '<p class="empty-hint">击杀怪物有概率获得技能书</p>';
    } else {
      for (const id of passives) {
        const ps = PASSIVE_SKILLS[id]; if (!ps) continue;
        ph += '<div class="skill-item passive"><span class="sk-emoji">' + ps.emoji + '</span><span class="sk-name">' + ps.name + '</span><span class="sk-desc">' + ps.desc + '</span></div>';
      }
    }
    $('passiveList').innerHTML = ph;
  }

  // 主动技能按钮只创建一次，之后仅更新文字和禁用状态，避免点击中 DOM 被替换。
  if (!skillBtnMap.__built) {
    let ah = '';
    for (const id of Object.keys(ACTIVE_SKILLS)) {
      const sk = ACTIVE_SKILLS[id];
      ah += '<button class="sk-btn" data-skill="' + id + '">'
        + '<span class="sk-label">' + sk.emoji + ' ' + sk.name + '</span>'
        + ' <span class="cd"></span>'
        + (sk.mp > 0 ? ' <span class="mp">' + sk.mp + '蓝</span>' : '')
        + '</button>';
    }
    $('activeList').innerHTML = ah;
    for (const id of Object.keys(ACTIVE_SKILLS)) {
      const btn = $('activeList').querySelector('[data-skill="' + id + '"]');
      skillBtnMap[id] = { btn, cd: btn.querySelector('.cd') };
    }
    skillBtnMap.__built = true;
  }
  for (const id of Object.keys(ACTIVE_SKILLS)) {
    const sk = ACTIVE_SKILLS[id];
    const ref = skillBtnMap[id];
    const cd = S.cds[id] || 0;
    const mpOk = (S.buffs.surge || 0) > 0 || sk.mp === 0 || S.life.curMP.gte(sk.mp);
    const disabled = cd > 0 || !mpOk || GAME_OVER;
    const burning = id === 'burn' && (S.buffs.burn || 0) > 0;
    ref.btn.disabled = disabled;
    ref.btn.classList.toggle('disabled', disabled);
    ref.btn.classList.toggle('burning', burning);
    ref.cd.textContent = cd > 0 ? Math.ceil(cd) + 's' : '';
  }

  // 药剂行同样保持稳定，只刷新库存与按钮状态。
  if (!potRowMap.__built) {
    let pt = '';
    for (const id of Object.keys(POTIONS)) {
      const pot = POTIONS[id];
      pt += '<div class="pot-item" data-potion-row="' + id + '">'
        + '<span class="pot-emoji">' + pot.emoji + '</span>'
        + '<span class="pot-name">' + pot.name + '</span>'
        + '<span class="pot-stock">×0</span>'
        + '<button class="pot-btn use" data-potion="' + id + '" data-act="use">用</button>'
        + '<button class="pot-btn buy" data-potion="' + id + '" data-act="buy">买' + pot.price + '</button>'
        + '</div>';
    }
    $('potionList').innerHTML = pt;
    for (const id of Object.keys(POTIONS)) {
      const row = $('potionList').querySelector('[data-potion-row="' + id + '"]');
      potRowMap[id] = {
        row,
        stock: row.querySelector('.pot-stock'),
        use: row.querySelector('[data-act="use"]'),
        buy: row.querySelector('[data-act="buy"]')
      };
    }
    potRowMap.__built = true;
  }
  for (const id of Object.keys(POTIONS)) {
    const ref = potRowMap[id];
    const stock = S.potions[id] || 0;
    ref.stock.textContent = '×' + stock;
    ref.use.disabled = stock <= 0 || GAME_OVER;
    ref.buy.disabled = GAME_OVER;
  }
}

// ---------------- 存档槽状态 ----------------
let saveSlotsRenderKey = '';
function renderSaveSlots() {
  // 槽位内容只在写入存档时变化（saveSlot 会更新 lastSaveTs/lastSaveSlot），无需每 tick 读 localStorage。
  const renderKey = S.lastSaveTs + '|' + S.lastSaveSlot + '|' + S.zone;
  if (renderKey === saveSlotsRenderKey) return;
  saveSlotsRenderKey = renderKey;

  for (let n = 1; n <= 3; n++) {
    const info = slotInfo(n);
    const card = $('saveSlot' + n);
    const state = $('slotState' + n);
    const meta = $('slotMeta' + n);
    const loadBtn = card.querySelector('[data-load]');
    card.classList.toggle('empty', !info);
    card.classList.toggle('has-save', !!info);
    card.classList.toggle('latest', !!info && S.lastSaveSlot === n);
    loadBtn.disabled = !info;

    if (!info) {
      state.textContent = '空槽';
      state.className = 'slot-state empty';
      meta.textContent = '还没有存档，可安全写入';
      continue;
    }
    const latest = S.lastSaveSlot === n;
    state.textContent = latest ? '● 最近使用' : '✓ 已有存档';
    state.className = 'slot-state ' + (latest ? 'latest' : 'saved');
    const time = info.savedAt ? new Date(info.savedAt).toLocaleString('zh-CN', { hour12:false }) : '时间未知';
    const zone = ZONES[info.zone] ? ZONES[info.zone].name : info.zone;
    meta.textContent = '第 ' + info.gen + ' 世 · ' + fmt(new Decimal(info.maxHP)) + ' 血 · ' + zone + '\n' + time;
  }
  if ($('saveRuleHint')) $('saveRuleHint').textContent = canSave() ? '当前位于安全区，可以存档' : '⚠️ 战斗区域不可存档，可先逃跑回村';
}

// ---------------- 墓园渲染（M6） ----------------
function renderGraveyard() {
  const list = graveyardAll();
  const el = $('graveyardList');
  if (list.length === 0) { el.innerHTML = '<p class="empty-hint">墓园空荡荡，尚无人长眠</p>'; return; }
  let html = '';
  for (const g of list) {
    const isGold = g.type === 'rebirth';
    html += '<div class="grave-item' + (isGold?' gold':'') + '">'
      + (isGold?'🟡':'⚫') + ' ' + (g.name||'无名氏') + ' · 第' + g.gen + '世 · 存活' + (g.lived||'?')
      + ' · 定格' + (g.maxHP ? fmt(new Decimal(g.maxHP)) : '?') + '血'
      + (g.cause ? ' · 亡于' + g.cause : ' · 飞升')
      + (g.epitaph ? '<br><span class="epitaph">「' + g.epitaph + '」</span>' : '')
      + '</div>';
  }
  el.innerHTML = html;
}

// ---------------- DOM 快捷 ----------------
const $ = (id) => document.getElementById(id);

// 文本写入缓存：值未变时跳过 DOM 写，降低每 tick 的写入次数
const textCache = new Map();
function setText(id, value) {
  const v = String(value);
  if (textCache.get(id) === v) return;
  textCache.set(id, v);
  $(id).textContent = v;
}
// bindUI 时缓存的静态引用，避免每个 tick 重复 querySelector(All)
let zoneBtnList = [];
let combatEl = null;

// ---------------- 天赋觉醒仪式（新档触发） ----------------
let talentCeremonyOpen = false;
let pendingTalent = null;

function goldRain(container, n) {
  const glyphs = ['✨', '⭐', '🌟', '💫', '🟡', '💰'];
  let html = '';
  for (let i = 0; i < n; i++) {
    const g = glyphs[Math.floor(Math.random() * glyphs.length)];
    const left = Math.random() * 100;
    const dur = 1.8 + Math.random() * 2.4;
    const delay = Math.random() * 2.5;
    const size = 12 + Math.random() * 18;
    html += '<span class="grain" style="left:' + left.toFixed(1) + '%;animation-duration:' + dur.toFixed(2) + 's;animation-delay:' + delay.toFixed(2) + 's;font-size:' + size.toFixed(0) + 'px">' + g + '</span>';
  }
  container.innerHTML = html;
}

