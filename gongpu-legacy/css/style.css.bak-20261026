/* ============================================================
 * 《普攻永久增加生命上限》 style.css  v2.0
 * 暗金主题 · 黑金拳圣风 · 纯文字+emoji
 * 主色：暗金=生命上限/拳圣/飞升  红=危险/HP/死亡
 *       绿=治疗/收益/可用  蓝=MP/读档  紫=魔法
 * ============================================================ */

:root {
  --bg0: #0a0a0c;
  --bg1: #131318;
  --bg2: #1a1a21;
  --panel: rgba(255, 255, 255, .035);
  --panel-2: rgba(255, 255, 255, .06);
  --border: rgba(232, 197, 104, .16);
  --border-strong: rgba(232, 197, 104, .32);
  --gold: #e8c568;
  --gold-bright: #f6dc82;
  --gold-dim: #b39a55;
  --red: #e05555;
  --red-dim: #a03a3a;
  --green: #5cb87e;
  --blue: #5b8dd9;
  --purple: #9b6fd9;
  --orange: #e08a4d;
  --txt: #eae7df;
  --txt-dim: #9a978c;
  --txt-faint: #6b6862;
  --radius: 14px;
  --shadow: 0 6px 24px rgba(0, 0, 0, .45);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  min-height: 100vh;
  background:
    radial-gradient(1000px 500px at 50% -10%, rgba(232, 197, 104, .07), transparent 60%),
    radial-gradient(800px 500px at 85% 15%, rgba(232, 197, 104, .04), transparent 55%),
    linear-gradient(180deg, var(--bg0), var(--bg1) 40%, var(--bg0));
  color: var(--txt);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  display: flex; flex-direction: column; align-items: center;
  padding: 18px 14px 48px;
}

/* 全局滚动条 */
::-webkit-scrollbar { width: 9px; height: 9px; }
::-webkit-scrollbar-track { background: var(--bg0); }
::-webkit-scrollbar-thumb { background: rgba(232, 197, 104, .25); border-radius: 5px; }
::-webkit-scrollbar-thumb:hover { background: rgba(232, 197, 104, .4); }

/* ---------- 游戏标题 ---------- */
.game-header {
  width: 100%; max-width: 1120px;
  text-align: center;
  margin-bottom: 4px;
}
.game-title {
  font-size: 30px; font-weight: 900; letter-spacing: 4px;
  background: linear-gradient(180deg, var(--gold-bright), var(--gold) 55%, var(--gold-dim));
  -webkit-background-clip: text; background-clip: text; color: transparent;
  text-shadow: 0 2px 24px rgba(232, 197, 104, .18);
}
.game-title .fist { -webkit-text-fill-color: initial; }
.game-sub {
  margin-top: 5px; color: var(--txt-dim); font-size: 12.5px; letter-spacing: 3px;
}
.game-sub em { color: var(--gold); font-style: normal; }

/* ---------- 顶栏：生命上限大数字 + 状态条 ---------- */
.topbar {
  width: 100%; max-width: 1120px;
  background: linear-gradient(180deg, var(--panel-2), var(--panel));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 20px 26px 16px;
  text-align: center;
  margin-top: 14px;
}
.hp-line { display: flex; align-items: baseline; justify-content: center; gap: 12px; }
.hp-icon { font-size: 30px; filter: drop-shadow(0 0 8px rgba(224, 85, 85, .5)); }
.hp-max-label { color: var(--gold-dim); font-size: 13px; letter-spacing: 3px; }
.hp-max {
  font-size: 52px; font-weight: 900; line-height: 1;
  background: linear-gradient(180deg, var(--gold-bright), var(--gold) 60%, #c8a24e);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  font-variant-numeric: tabular-nums;
  filter: drop-shadow(0 2px 14px rgba(232, 197, 104, .25));
}
.hp-max.pulse { animation: pulse .35s ease-out; }
@keyframes pulse {
  0% { transform: scale(1); }
  40% { transform: scale(1.14); }
  100% { transform: scale(1); }
}
.bless-row { color: var(--gold); font-size: 12px; margin-top: 8px; letter-spacing: 1.5px; }

.bars { display: flex; flex-direction: column; gap: 7px; margin-top: 14px; }
.bar {
  position: relative; height: 24px; border-radius: 12px;
  background: rgba(0, 0, 0, .45);
  border: 1px solid rgba(255, 255, 255, .07);
  overflow: hidden;
}
.bar .fill {
  height: 100%; width: 100%;
  background: linear-gradient(90deg, var(--red-dim), var(--red));
  transition: width .15s linear;
}
.bar.mp .fill { background: linear-gradient(90deg, #3a5a8c, var(--blue)); }
.bar.mob .fill { background: linear-gradient(90deg, #b06a2a, var(--orange)); }
.bar-txt {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 12px; color: #fff; text-shadow: 0 1px 3px rgba(0, 0, 0, .9);
  font-variant-numeric: tabular-nums;
}

.meta-row { display: flex; justify-content: space-between; margin-top: 12px; font-size: 13px; }
.gen { color: var(--gold); letter-spacing: 2px; font-weight: 700; }
.saveok { color: var(--green); }
.savewarn { color: var(--red); }

/* ---------- 主体三栏 ---------- */
.cols {
  width: 100%; max-width: 1120px;
  display: grid; gap: 16px; margin-top: 16px;
  grid-template-columns: 1.05fr 1.35fr 1fr;
}
@media (max-width: 860px) { .cols { grid-template-columns: 1fr; } }

.panel {
  background: linear-gradient(180deg, var(--panel-2), var(--panel));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 18px;
  transition: border-color .2s, transform .2s;
}
.panel:hover { border-color: var(--border-strong); }
.panel h3 {
  font-size: 13px; color: var(--gold-dim); letter-spacing: 3px; font-weight: 700;
  border-left: 3px solid var(--gold); padding-left: 9px;
  margin: 6px 0 12px;
}

/* 属性表 */
.stats { width: 100%; border-collapse: collapse; }
.stats td { padding: 5px 2px; font-size: 13px; border-bottom: 1px dashed rgba(255, 255, 255, .06); }
.stats td:first-child { color: var(--txt-dim); }
.stats td:last-child { text-align: right; font-variant-numeric: tabular-nums; color: var(--txt); font-weight: 600; }

/* ---------- 战斗区（核心，金色强调） ---------- */
.combat {
  border-color: var(--border-strong);
  box-shadow: 0 0 0 1px rgba(232,197,104,.06), var(--shadow);
  position: relative;
}
.combat::before {
  content: '⚔'; position: absolute; right: 14px; top: 12px;
  font-size: 15px; opacity: .35; color: var(--gold);
}
.combat h3 { border-color: var(--gold); color: var(--gold); font-size: 14px; }
.combat { display: flex; flex-direction: column; gap: 12px; }
.mob {
  display: flex; align-items: center; gap: 16px;
  background: linear-gradient(160deg, rgba(232,197,104,.06), rgba(0,0,0,.3));
  border: 1px solid var(--border);
  border-radius: 12px; padding: 16px;
}
.mob-emoji {
  font-size: 54px;
  filter: drop-shadow(0 3px 10px rgba(0,0,0,.6));
}
.mob-info { flex: 1; display: flex; flex-direction: column; gap: 8px; }
.mob-name { font-size: 17px; font-weight: 700; color: var(--txt); }
.mob-desc { color: var(--txt-dim); font-size: 12px; }
.combat-btns { display: flex; gap: 10px; }
.skill-btn {
  flex: 1; padding: 13px; border: 1px solid var(--border-strong); border-radius: 10px;
  background: linear-gradient(160deg, rgba(232,197,104,.16), rgba(232,197,104,.06));
  color: var(--gold-bright); font-size: 14px; font-weight: 700; cursor: pointer;
  transition: transform .1s, background .2s, box-shadow .2s;
}
.skill-btn:hover:not(:disabled) {
  transform: translateY(-2px);
  background: linear-gradient(160deg, rgba(232,197,104,.26), rgba(232,197,104,.1));
  box-shadow: 0 4px 14px rgba(232,197,104,.2);
}
.skill-btn:disabled { opacity: .35; cursor: not-allowed; transform: none; }
.burn-buff { color: var(--orange); font-size: 13px; min-height: 18px; text-align: center; }

/* ---------- 地图 / 存档 ---------- */
.zones { display: flex; flex-direction: column; gap: 8px; }
.zone-btn {
  padding: 12px; border: 1px solid var(--border); border-radius: 10px;
  background: rgba(232,197,104,.05); color: var(--txt); font-size: 14px; cursor: pointer;
  text-align: left; transition: background .2s, border-color .2s, transform .1s;
}
.zone-btn:hover:not(:disabled) { background: rgba(232,197,104,.14); border-color: var(--border-strong); transform: translateX(3px); }
.zone-btn .req { display: block; font-size: 11px; color: var(--txt-dim); margin-top: 3px; }
.zone-btn.locked { opacity: .38; border-color: rgba(224,85,85,.25); background: rgba(224,85,85,.04); cursor: not-allowed; }
.zone-btn.locked:hover { background: rgba(224,85,85,.04); transform: none; }

.save-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 8px; }
.save-grid button {
  padding: 10px; border: 1px solid var(--border); border-radius: 8px;
  background: var(--panel-2); color: var(--txt); font-size: 13px; cursor: pointer;
  transition: background .2s;
}
.save-grid button:hover { background: rgba(232,197,104,.15); border-color: var(--border-strong); }

.autosave { display: flex; align-items: center; gap: 6px; margin-top: 12px; font-size: 12px; color: var(--txt-dim); cursor: pointer; }
.autosave input { accent-color: var(--gold); }

#ioText {
  width: 100%; height: 56px; margin: 6px 0;
  background: rgba(0,0,0,.4); border: 1px solid var(--border);
  border-radius: 8px; color: #cfcabf; font-size: 10px; padding: 8px;
  resize: none; word-break: break-all; font-family: monospace;
}

/* ---------- 死亡画面 ---------- */
.death-mask {
  position: fixed; inset: 0; z-index: 100;
  background: rgba(4, 2, 8, .94);
  backdrop-filter: blur(4px);
  display: flex; align-items: center; justify-content: center;
}
.death-box {
  max-width: 470px; width: 92%;
  background: linear-gradient(165deg, #1c0f0f, #120a0a);
  border: 1px solid rgba(224, 85, 85, .5);
  border-radius: 18px;
  box-shadow: 0 12px 48px rgba(224,85,85,.15);
  padding: 36px 30px; text-align: center;
}
.death-box h2 { font-size: 34px; margin-bottom: 18px; color: var(--red); }
.death-box p { color: #b8aca4; font-size: 14px; margin: 8px 0; }
.death-box b { color: var(--gold); font-size: 20px; }
.death-save-info { color: var(--orange) !important; font-size: 13px !important; }
.death-autopsy { color: #b8aca4; font-size: 12px; margin: 10px 0; padding: 12px; background: rgba(0,0,0,.4); border-radius: 8px; text-align: left; line-height: 1.7; }
.death-btns { display: flex; flex-direction: column; gap: 10px; margin-top: 22px; }
.d-btn {
  padding: 13px; border: 1px solid transparent; border-radius: 10px;
  font-size: 15px; cursor: pointer; transition: filter .2s, transform .1s;
}
.d-btn.load { background: linear-gradient(135deg, #3a5a8c, var(--blue)); color: #fff; }
.d-btn.new { background: var(--panel-2); color: var(--txt-dim); border-color: var(--border); }
.d-btn:hover { filter: brightness(1.15); transform: translateY(-1px); }

/* ---------- toast ---------- */
.toast {
  position: fixed; bottom: 26px; left: 50%;
  transform: translateX(-50%) translateY(80px);
  background: rgba(24, 22, 16, .96);
  border: 1px solid var(--border-strong);
  padding: 11px 24px; border-radius: 24px;
  font-size: 13px; color: var(--txt);
  opacity: 0; pointer-events: none;
  transition: all .25s ease;
  z-index: 200; white-space: nowrap;
  box-shadow: 0 6px 24px rgba(0,0,0,.5);
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ---------- 装备栏（M3） ---------- */
.equip-bar {
  width: 100%; max-width: 1120px; margin-top: 16px;
}
.equip-cols { display: grid; grid-template-columns: 320px 1fr; gap: 16px; }
@media (max-width: 860px) { .equip-cols { grid-template-columns: 1fr; } }
.equipped-box, .bag-box {
  background: linear-gradient(180deg, var(--panel-2), var(--panel));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 18px;
}
.equipped-box h3, .bag-box h3 {
  font-size: 13px; color: var(--gold-dim); letter-spacing: 3px; font-weight: 700;
  border-left: 3px solid var(--gold); padding-left: 9px; margin-bottom: 12px;
}
.bag-count { float: right; font-size: 12px; color: var(--txt-dim); font-weight: 400; letter-spacing: 0; }
.equipped-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
.eq-slot {
  display: flex; align-items: center; gap: 5px; padding: 7px 9px;
  border: 1px solid var(--border); border-radius: 8px;
  font-size: 12px; background: rgba(0,0,0,.25);
}
.eq-slot.empty { opacity: .32; border-style: dashed; }
.eq-emoji { font-size: 16px; }
.eq-name { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
.eq-aff { font-size: 10px; color: var(--txt-dim); }
.eq-btn {
  padding: 3px 8px; border: none; border-radius: 4px;
  background: rgba(224,85,85,.16); color: #f08a8a; font-size: 11px; cursor: pointer;
}
.eq-btn:hover { background: rgba(224,85,85,.3); }
.bag-list { max-height: 300px; overflow-y: auto; padding-right: 4px; }
.bag-item {
  display: flex; align-items: center; gap: 7px; padding: 9px;
  border: 1px solid var(--border); border-radius: 8px;
  margin-bottom: 7px; font-size: 12px; background: rgba(0,0,0,.25);
  transition: border-color .15s;
}
.bag-item:hover { border-color: var(--border-strong); }
.bag-emoji { font-size: 19px; }
.bag-name { flex: 0 0 auto; font-weight: 600; }
.bag-aff { font-size: 10px; color: var(--txt-dim); flex: 1; overflow: hidden; }
.bag-btns { display: flex; gap: 4px; flex-shrink: 0; }
.bag-btns button {
  padding: 5px 9px; border: 1px solid transparent; border-radius: 5px;
  background: rgba(92,184,126,.14); color: var(--green); font-size: 11px; cursor: pointer;
  transition: filter .15s;
}
.bag-btns button:hover { filter: brightness(1.35); }
.bag-btns button[data-act="discard"] { background: rgba(224,85,85,.14); color: #f08a8a; }
.bag-btns button[data-act="sell"] { background: rgba(232,197,104,.14); color: var(--gold); }
.empty-hint { color: var(--txt-faint); font-size: 12px; text-align: center; padding: 22px; }

/* ---------- 技能+药剂栏（M4） ---------- */
.skill-bar { width: 100%; max-width: 1120px; margin-top: 16px; }
.skill-cols { display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: 16px; }
@media (max-width: 860px) { .skill-cols { grid-template-columns: 1fr; } }
.passive-box, .active-box, .potion-box {
  min-width: 0;
  background: linear-gradient(180deg, var(--panel-2), var(--panel));
  border: 1px solid var(--border);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 18px;
}
.skill-bar h3 {
  font-size: 13px; color: var(--gold-dim); letter-spacing: 3px; font-weight: 700;
  border-left: 3px solid var(--gold); padding-left: 9px; margin-bottom: 12px;
}
.passive-list { display: flex; flex-direction: column; gap: 7px; }
.skill-item {
  display: flex; align-items: center; gap: 7px; font-size: 12px;
  padding: 8px 10px; background: rgba(0,0,0,.25);
  border: 1px solid var(--border); border-radius: 8px;
}
.sk-emoji { font-size: 16px; }
.sk-name { font-weight: 700; color: var(--gold); }
.sk-desc { color: var(--txt-dim); flex: 1; }
.active-list { display: flex; flex-wrap: wrap; gap: 7px; }
.sk-btn {
  padding: 9px 13px; border: 1px solid var(--border-strong); border-radius: 8px;
  background: rgba(232,197,104,.08); color: var(--gold-bright); font-size: 12px; cursor: pointer;
  transition: background .15s, transform .1s;
}
.sk-btn:hover:not(.disabled) { background: rgba(232,197,104,.2); transform: translateY(-1px); }
.sk-btn.disabled { opacity: .4; cursor: not-allowed; border-color: var(--border); background: var(--panel); color: var(--txt-dim); }
.sk-btn .cd { color: var(--red); }
.sk-btn .mp { color: var(--blue); }
.potion-list { display: flex; flex-direction: column; gap: 7px; }
.pot-item {
  display: flex; align-items: center; gap: 7px; font-size: 12px;
  padding: 8px 10px; background: rgba(0,0,0,.25);
  border: 1px solid var(--border); border-radius: 8px;
}
.pot-emoji { font-size: 16px; }
.pot-name { flex: 0 0 auto; font-weight: 600; }
.pot-stock { flex: 1; color: var(--txt-dim); }
.pot-btn {
  padding: 5px 9px; border: 1px solid transparent; border-radius: 5px;
  font-size: 11px; cursor: pointer; transition: filter .15s;
}
.pot-btn.use { background: rgba(92,184,126,.16); color: var(--green); }
.pot-btn.buy { background: rgba(91,141,217,.16); color: var(--blue); }
.pot-btn:disabled { opacity: .3; cursor: not-allowed; }
.pot-btn:hover:not(:disabled) { filter: brightness(1.4); }

/* ---------- 墓园（M6） ---------- */
.grave-btn {
  width: 100%; margin-top: 12px; padding: 11px;
  border: 1px solid rgba(160, 150, 130, .3);
  border-radius: 10px; background: rgba(160,150,130,.07);
  color: #c9c2b2; font-size: 13px; cursor: pointer; transition: background .2s;
}
.grave-btn:hover { background: rgba(160,150,130,.15); }
.graveyard-box {
  max-width: 520px; width: 92%;
  background: linear-gradient(165deg, #181510, #100e0a);
  border: 1px solid rgba(160,150,130,.35); border-radius: 18px;
  box-shadow: var(--shadow);
  padding: 30px 26px;
}
.graveyard-box h2 { text-align: center; margin-bottom: 18px; color: #c9c2b2; }
.graveyard-list { max-height: 380px; overflow-y: auto; margin-bottom: 18px; padding-right: 4px; }
.grave-item {
  padding: 12px; margin-bottom: 9px; border-radius: 9px;
  background: rgba(40, 38, 34, .5); font-size: 12px; line-height: 1.7;
  border: 1px solid rgba(255,255,255,.05);
}
.grave-item.gold { background: rgba(232,197,104,.1); border: 1px solid var(--border-strong); }
.epitaph { color: #948d7c; font-style: italic; }
.death-epitaph {
  width: 100%; margin: 8px 0; padding: 9px 13px;
  background: rgba(0,0,0,.4); border: 1px solid var(--border);
  border-radius: 8px; color: #d5d0c4; font-size: 13px; box-sizing: border-box;
}

/* ---------- 飞升面板（M7） ---------- */
.rebirth-btn {
  background: linear-gradient(160deg, rgba(232,197,104,.25), rgba(232,197,104,.1)) !important;
  border-color: var(--border-strong) !important;
  color: var(--gold-bright) !important;
  box-shadow: 0 0 18px rgba(232,197,104,.15);
  animation: glow 2s ease-in-out infinite;
}
@keyframes glow {
  0%, 100% { box-shadow: 0 0 12px rgba(232,197,104,.15); }
  50% { box-shadow: 0 0 24px rgba(232,197,104,.35); }
}
.rebirth-box {
  max-width: 440px; width: 92%;
  background: linear-gradient(165deg, #1d1a10, #12100a);
  border: 1px solid var(--border-strong); border-radius: 18px;
  box-shadow: 0 12px 48px rgba(232,197,104,.15);
  padding: 30px 26px; text-align: center;
}
.rebirth-box h2 { color: var(--gold); margin-bottom: 14px; }
.rebirth-box p { color: var(--txt-dim); font-size: 13px; margin-bottom: 18px; line-height: 1.6; }
.rebirth-choices { display: flex; flex-wrap: wrap; gap: 9px; justify-content: center; }
.rebirth-choice {
  padding: 11px 17px; border: 1px solid var(--border-strong); border-radius: 10px;
  background: rgba(232,197,104,.1); color: var(--gold-bright); font-size: 13px; cursor: pointer;
  transition: background .15s, transform .1s;
}
.rebirth-choice:hover { background: rgba(232,197,104,.22); transform: translateY(-1px); }
