// ---------------- 生效效果区（属性面板滚动区，统一展示天赋/被动/状态） ----------------
let lastEffectAreaKey = '';
function renderEffects() {
  const area = $('effectArea');
  if (!area) return;
  const eternal = typeof eternalActive === 'function' && eternalActive();

  // ---- 天赋 ----
  let talentHtml = '';
  if (S.talent && TALENTS[S.talent]) {
    const tl = TALENTS[S.talent];
    if (S.talent === 'eternal') {
      talentHtml = '<div class="effect-chip talent eternal">♾️ <b>被动永续</b> · 所有增益永久存续'
        + (eternal ? '' : ' <s class="effect-off">（沉默中）</s>') + '</div>';
    } else {
      talentHtml = '<div class="effect-chip talent">' + tl.emoji + ' <b>' + tl.name + '</b> · ' + tl.desc + '</div>';
    }
  }

  // ---- 已学被动技能 ----
  let passiveHtml = '';
  for (const id of (S.skills.passives || [])) {
    const ps = PASSIVE_SKILLS[id]; if (!ps) continue;
    passiveHtml += '<div class="effect-chip passive">' + ps.emoji + ' ' + ps.name + ' · ' + ps.desc + '</div>';
  }

  // ---- 装备特殊词条（生命泉涌等史诗词条） ----
  let relicHtml = '';
  for (const slot of Object.keys(S.equipped || {})) {
    const item = S.equipped[slot]; if (!item) continue;
    for (const a of (item.affixes || [])) {
      if (a.type === 'pct_hp') relicHtml += '<div class="effect-chip relic">❇️ ' + a.name + ' · 每秒回 ' + (a.val * 100).toFixed(0) + '% 血量（' + item.name + '）</div>';
    }
  }

  // ---- 当前 buff / debuff：按 BUFF_META.group 拆两组 ----
  // group=passive → 主动技能/药剂带来的持续被动（燃烧/格挡/急速/涌动/兔肉/速度药剂），归入「被动」
  // group=status  → 战斗持续状态（怪物毒/灼烧/沉默），归入「状态」
  let skillBuffHtml = '', statusBuffHtml = '';
  const keys = Object.keys(S.buffs).filter(k => (S.buffs[k] || 0) > 0);
  for (const k of keys) {
    const meta = BUFF_META[k] || { name: k, emoji: '❔', good: true, group: 'status' };
    const isEternalBuff = eternal && meta.good && ETERNAL_BUFFS.indexOf(k) >= 0;
    const time = isEternalBuff ? '<b class="effect-inf">♾️ 永续</b>' : Math.ceil(S.buffs[k]) + 's';
    const chip = '<div class="effect-chip ' + (meta.good ? 'buff' : 'debuff') + (isEternalBuff ? ' eternal' : '') + '">'
      + meta.emoji + ' ' + meta.name + ' <span class="effect-time">' + time + '</span></div>';
    if (meta.group === 'passive') skillBuffHtml += chip; else statusBuffHtml += chip;
  }

  // ---- 分三组展示：天赋 / 被动（被动技能+装备词条+持续被动）/ 状态（战斗持续状态） ----
  const talentGroup = '<div class="effect-group"><div class="effect-group-title">🧬 天赋</div>'
    + (talentHtml || '<div class="effect-none">尚未觉醒天赋</div>') + '</div>';
  const passiveGroup = '<div class="effect-group"><div class="effect-group-title">📖 被动</div>'
    + (passiveHtml + relicHtml + skillBuffHtml || '<div class="effect-none">打怪学习被动技能</div>') + '</div>';
  const buffGroup = '<div class="effect-group"><div class="effect-group-title">⚡ 状态</div>'
    + (statusBuffHtml || '<div class="effect-none">暂无战斗状态</div>') + '</div>';

  // 缓存键：内容整体求值即可（行数少，成本低；buff 用 ceil 秒数天然按秒刷新）
  const body = talentGroup + passiveGroup + buffGroup;
  const key = body;
  if (key === lastEffectAreaKey) return;
  lastEffectAreaKey = key;
  area.innerHTML = body;
}

// ---------------- 渲染 ----------------
let lastMaxHPShown = '0';

const UI = {
  render(dt) {
    if (GAME_OVER) return;
    const p = getPanel();

    // 新档天赋觉醒仪式（无天赋且未在仪式中）
    if (!S.talent && !talentCeremonyOpen) showTalentCeremony();
    renderEffects();

    // 大数字跳动（+1 动画）
    const hpStr = fmt(p.maxHP);
    if (hpStr !== lastMaxHPShown) {
      $('hpMax').textContent = hpStr;
      pulse('hpMax');
      lastMaxHPShown = hpStr;
    }
    $('hpCur').textContent = fmt(p.curHP);
    $('hpBar').style.width = p.curHP.div(p.maxHP).times(100).toNumber().toFixed(1) + '%';
    $('mpCur').textContent = fmt(p.curMP);
    $('mpBar').style.width = p.curMP.div(p.MP).times(100).toNumber().toFixed(1) + '%';

    // 世代
    setText('gen', '第 ' + S.gen + ' 世');
    // 赋能行
    const bl = Object.keys(S.blessings).map(k => k + '+' + (BLESS_STEP[k] * (1 + S.blessings[k].lv)) + '/拳').join(' · ');
    setText('blessRow', '🧬 赋能: ' + bl);

    // 存档状态
    const gap = S.lastSaveTs ? Math.floor((Date.now() - S.lastSaveTs) / 60000) : -1;
    $('saveState').innerHTML = gap < 0
      ? '<span style="color:#e74c3c">⚠️ 从未存档</span>'
      : (gap === 0 ? '✅ 刚刚已存档' : '✅ ' + gap + ' 分钟前已存档（槽' + S.lastSaveSlot + '）');
    const unsafeGap = gap < 0 || gap > 5 || ZONES[S.zone].safe === false;
    $('saveState').className = unsafeGap && gap !== 0 ? 'savewarn' : 'saveok';

    // 属性面板（燃烧期物攻/魔攻高亮）
    const burnOn = (S.buffs.burn || 0) > 0;
    setText('stPATK', fmt(p.PATK));
    setText('stMATK', fmt(p.MATK));
    $('stPATK').classList.toggle('burn-val', burnOn);
    $('stMATK').classList.toggle('burn-val', burnOn);
    setText('stPDEF', fmt(p.PDEF));
    setText('stMDEF', fmt(p.MDEF));
    setText('stASPD', p.ASPD.toFixed(2) + '/s');
    setText('stRNG', p.RNG.toFixed(1) + ' 步');
    setText('stSPD', fmt(p.SPD));
    setText('stCRIT', fmtPct(p.CRIT));
    setText('stCRITD', p.CRITD.toFixed(2) + '×');
    setText('stACC', fmtPct(p.ACC));
    setText('stEVA', fmtPct(p.EVA));
    setText('stREGEN', fmt(p.REGEN) + '/s');
    setText('stGold', fmt(p.gold));

    // 统计
    setText('stPunch', fmt(S.stats.punches));
    setText('stKill', S.stats.kills);
    setText('stLived', fmtDur(Date.now() - S.stats.born));

    // 战斗区
    const mob = S.mob;
    if (mob) {
      setText('mobEmoji', mob.def.emoji);
      setText('mobName', mob.def.name + (mob.def.maxHP === Infinity ? '（无限血）' : ''));
      if (mob.def.maxHP === Infinity) {
        setText('mobHp', '∞');
        $('mobBar').style.width = '100%';
      } else {
        setText('mobHp', fmt(mob.curHP.max(0)) + ' / ' + mob.def.maxHP.toLocaleString('zh-CN'));
        $('mobBar').style.width = (mob.curHP.div(mob.def.maxHP).times(100).max(0).toNumber().toFixed(1)) + '%';
      }
      setText('mobDesc', mob.def.desc || '');
    }
    // 燃烧生命按钮 + 战斗区燃烧视觉
    const burnCd = S.cds.burn || 0;
    setText('btnBurn', burnCd > 0
      ? '🔥 燃烧生命 (CD ' + Math.ceil(burnCd) + 's)'
      : '🔥 燃烧生命');
    $('btnBurn').disabled = burnCd > 0 || S.life.curHP.lte(S.life.maxHP.times(0.3));
    setText('burnBuff', burnOn ? '🔥 攻击翻倍中 ' + S.buffs.burn.toFixed(1) + 's' : '');
    $('burnBuff').classList.toggle('on', burnOn);
    if (combatEl) combatEl.classList.toggle('burning', burnOn);

    // 区域名
    setText('zoneName', ZONES[S.zone].emoji + ' ' + ZONES[S.zone].name);

    // M7: 飞升检测
    $('btnRebirth').style.display = checkRebirthReady() ? '' : 'none';

    // 地图按钮门槛禁用
    for (const btn of zoneBtnList) {
      const zid = btn.dataset.zone;
      const chk = checkZoneReq(zid);
      btn.classList.toggle('locked', !chk.ok);
      btn.disabled = !chk.ok && zid !== 'village';
    }
    // 装备区（M3）
    renderEquip();
    // 技能+药剂区（M4）
    renderSkills();
    // 存档槽状态（仅存档内容变化时更新）
    renderSaveSlots();
    // 状态栏 buff 条已迁至属性面板「生效效果」区（renderEffects）
  },

  // ---------------- 死亡画面 ----------------
  showDeath(info) {
    const k = info.killer;
    $('deathKiller').textContent = k ? k.emoji + ' ' + k.name : '未知';
    $('deathHP').textContent = fmt(info.panel.maxHP);
    $('deathPunches').textContent = fmt(new Decimal(info.punches));
    $('deathLived').textContent = fmtDur(info.livedMs);
    const gapMin = S.lastSaveTs ? Math.floor((Date.now() - S.lastSaveTs) / 60000) : -1;
    $('deathSave').textContent = gapMin < 0 ? '你从未存过档' : '最近存档：' + gapMin + ' 分钟前（生命 ' + fmt(slotInfoHP()) + '）';
    $('btnLoadLast').style.display = S.lastSaveTs ? '' : 'none';
    // M5: 尸检报告
    if (info.analysis) {
      const a = info.analysis;
      let html = '📋 尸检：死因 ' + a.cause;
      if (a.physDmg > 0) html += '（物伤缺口 ' + a.physDmg + '）';
      if (a.magDmg > 0) html += '（魔伤缺口 ' + a.magDmg + '）';
      if (a.suggestions && a.suggestions.length) html += '<br>建议：' + a.suggestions.join('；');
      $('deathAutopsy').innerHTML = html;
    }
    $('deathMask').style.display = 'flex';
  },

  hideDeath() { $('deathMask').style.display = 'none'; }
};

function slotInfoHP() {
  // 读最近槽位面板（仅显示用）
  try {
    const best = loadLatestPreview();
    return best ? best : '?';
  } catch (e) { return '?'; }
}
function loadLatestPreview() {
  let bestTs = 0, hp = '?';
  for (let i = 0; i < 3; i++) {
    const raw = localStorage.getItem(SAVE_KEYS.slots[i]);
    if (!raw) continue;
    const o = JSON.parse(raw);
    if ((o.savedAt || 0) > bestTs) { bestTs = o.savedAt; hp = o.life ? o.life.maxHP : '?'; }
  }
  return hp;
}

// ---------------- 小工具 ----------------
function pulse(id) {
  const el = $(id);
  el.classList.remove('pulse');
  void el.offsetWidth;          // 重启动画
  el.classList.add('pulse');
}
function fmtDur(ms) {
  const m = Math.floor(ms / 60000), h = Math.floor(m / 60), d = Math.floor(h / 24);
  if (d > 0) return d + '天' + (h % 24) + '时';
  if (h > 0) return h + '时' + (m % 60) + '分';
  return m + '分';
}

// ---------------- 单屏标签页 ----------------
function bindGameTabs() {
  const tabs = Array.from(document.querySelectorAll('.game-tab[data-tab]'));
  const panes = Array.from(document.querySelectorAll('.tab-pane[data-pane]'));
  if (!tabs.length) return;

  function activate(name, focus) {
    if (!tabs.some(tab => tab.dataset.tab === name)) name = 'equip';
    tabs.forEach(tab => {
      const active = tab.dataset.tab === name;
      tab.classList.toggle('active', active);
      tab.setAttribute('aria-selected', active ? 'true' : 'false');
      tab.tabIndex = active ? 0 : -1;
      if (active && focus) tab.focus();
    });
    panes.forEach(pane => {
      const active = pane.dataset.pane === name;
      pane.classList.toggle('active', active);
      pane.hidden = !active;
    });
    try { localStorage.setItem('gp-ui-tab', name); } catch (e) { /* 隐私模式下仅不记忆 */ }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activate(tab.dataset.tab, false));
    tab.addEventListener('keydown', event => {
      if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
      event.preventDefault();
      const step = event.key === 'ArrowRight' ? 1 : -1;
      activate(tabs[(index + step + tabs.length) % tabs.length].dataset.tab, true);
    });
  });

  let initial = 'equip';
  try { initial = localStorage.getItem('gp-ui-tab') || initial; } catch (e) { /* 使用默认页 */ }
  activate(initial, false);
}

// 用户操作后同步刷新，不等下一次 100ms tick。
function finishAction(result) {
  UI.render(0);
  if (result) toast(result.msg);
}

// ---------------- 按钮绑定 ----------------
function bindUI() {
  bindGameTabs();
  zoneBtnList = Array.from(document.querySelectorAll('[data-zone]'));
  combatEl = document.querySelector('.combat');

  // 地图
  document.querySelectorAll('[data-zone]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (GAME_OVER) return;
      const zid = btn.dataset.zone;
      const ok = gotoZone(zid);              // 内部检查门槛，失败会 toast
      if (ok && zid !== 'village') {
        toast('⚠️ 进入 ' + ZONES[zid].name + '：战斗中不可存档，死亡只能回档');
      }
    });
  });
  $('btnBurn').addEventListener('click', () => castBurn());
  $('btnFlee').addEventListener('click', () => flee());

  // 装备操作（事件委托，背包内容动态）
  $('bagList').addEventListener('click', e => {
    const btn = e.target.closest('[data-act]'); if (!btn || GAME_OVER) return;
    const act = btn.dataset.act, idx = Number(btn.dataset.idx);
    let r = null;
    if (act === 'equip') r = equipItem(idx);
    else if (act === 'enhance') r = enhanceItem(idx);
    else if (act === 'sell') r = sellItem(idx);
    else if (act === 'discard') r = discardItem(idx);
    finishAction(r);
  });
  $('equippedSlots').addEventListener('click', e => {
    const btn = e.target.closest('[data-unequip]'); if (!btn || GAME_OVER) return;
    finishAction(unequipItem(btn.dataset.unequip));
  });

  // 主动技能（M4）
  $('activeList').addEventListener('click', e => {
    const btn = e.target.closest('[data-skill]'); if (!btn || GAME_OVER) return;
    const ok = castSkill(btn.dataset.skill);
    finishAction(ok ? null : { msg:'无法施放（CD中/蓝不足/血不足）' });
  });
  // 药剂（M4）
  $('potionList').addEventListener('click', e => {
    const btn = e.target.closest('[data-potion]'); if (!btn || GAME_OVER) return;
    const act = btn.dataset.act, id = btn.dataset.potion;
    finishAction(act === 'use' ? usePotion(id) : buyPotion(id));
  });

  // 墓园（M6）
  $('btnGraveyard').addEventListener('click', () => {
    renderGraveyard();
    $('graveyardMask').style.display = 'flex';
  });
  $('btnCloseGrave').addEventListener('click', () => { $('graveyardMask').style.display = 'none'; });

  // 飞升（M7）
  $('btnRebirth').addEventListener('click', () => {
    if (GAME_OVER) return;
    let html = '';
    for (const key of BLESS_ORDER) {
      const step = BLESS_STEP[key];
      const has = !!S.blessings[key];
      const label = has ? '强化 ' + key + '（步长升级）' : '新增 ' + key + '（+' + step + '/拳）';
      html += '<button class="rebirth-choice" data-bless="' + key + '">' + label + '</button>';
    }
    $('rebirthChoices').innerHTML = html;
    $('rebirthMask').style.display = 'flex';
  });
  $('rebirthChoices').addEventListener('click', e => {
    const btn = e.target.closest('[data-bless]'); if (!btn) return;
    const r = rebirth(btn.dataset.bless);
    $('rebirthMask').style.display = 'none';
    toast(r.msg);
  });

  // 存档
  document.querySelectorAll('[data-save]').forEach(btn =>
    btn.addEventListener('click', () => finishAction(saveSlot(Number(btn.dataset.save)))));
  document.querySelectorAll('[data-load]').forEach(btn =>
    btn.addEventListener('click', () => finishAction(loadSlot(Number(btn.dataset.load)))));

  // 导出导入
  $('btnExport').addEventListener('click', () => {
    const code = exportSave();
    $('ioText').value = code;
    $('ioText').select();
    toast('存档已生成，Ctrl+C 复制保存');
  });
  $('btnImport').addEventListener('click', () => {
    const t = $('ioText').value.trim();
    if (!t) return toast('先粘贴存档文本');
    toast(importSave(t).msg);
  });

  // 自动存档开关
  $('autoSaveChk').addEventListener('change', e => { S.autoSave = e.target.checked; });

  // 重新开档（活着时主动重开，带确认）
  $('btnRestart').addEventListener('click', () => {
    if (GAME_OVER) return;
    $('restartMask').style.display = 'flex';
  });
  $('btnRestartNo').addEventListener('click', () => { $('restartMask').style.display = 'none'; });
  $('btnRestartYes').addEventListener('click', () => {
    $('restartMask').style.display = 'none';
    newGame();
    toast('第 0 世，重新来过（旧档进度已清空）');
  });

  // 死亡画面
  $('btnLoadLast').addEventListener('click', () => {
    const r = loadLatest();
    if (r.ok) { UI.hideDeath(); toast(r.msg); } else toast(r.msg);
  });
  $('btnNewGame').addEventListener('click', () => {
    if (deathInfo) {
      const epitaph = $('deathEpitaph').value.trim() || '安息';
      graveyardAdd({
        name: '无名氏', gen: deathInfo.gen, lived: fmtDur(deathInfo.livedMs),
        maxHP: deathInfo.panel.maxHP.toString(), cause: deathInfo.killer ? deathInfo.killer.name : '未知',
        type: 'death', epitaph, ts: Date.now()
      });
      $('deathEpitaph').value = '';
    }
    newGame();
    UI.hideDeath();
    toast('第 0 世，重新来过');
  });
}

// ---------------- toast ----------------
function toast(msg) {
  const el = $('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2200);
}
