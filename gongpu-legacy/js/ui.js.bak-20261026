/* ============================================================
 * 《普攻永久增加生命上限》 ui.js
 * 纯文字 + emoji 渲染层（DESIGN.md §13 界面规划）
 * 大数字格式化（中文大数）/ +1 跳动 / 死亡画面
 * ============================================================ */

/* global S, GAME_OVER, deathInfo, ZONES, SKILLS, CN_UNITS, getPanel,
          gotoZone, flee, castBurn, saveSlot, loadSlot, loadLatest, newGame,
          exportSave, importSave, graveyardAdd, markPanelDirty */

// ---------------- 中文大数格式化 ----------------
function fmt(d) {
  if (!(d instanceof Decimal)) d = new Decimal(d);
  if (d.lt(10000)) return Math.floor(d.toNumber()).toLocaleString('zh-CN');
  const n = d.toNumber();
  // 到 1e44（载）；超过后走 break_infinity 科学计数法
  for (let i = CN_UNITS.length - 1; i >= 1; i--) {
    const [name, scale] = CN_UNITS[i];
    if (n >= scale && n < scale * 10000) {
      return (n / scale).toFixed(2) + name;
    }
  }
  if (n >= 1e44) return d.toString().slice(0, 12); // 兜底
  return Math.floor(n).toLocaleString('zh-CN');
}
function fmtPct(x) { return (x * 100).toFixed(1) + '%'; }

// ---------------- 装备渲染（M3） ----------------
function slotLabel(slot) {
  const m = { weapon:'武器', offhand:'副手', bow:'弓', head:'头', chest:'胸', legs:'腿', boots:'鞋', ring1:'戒1', ring2:'戒2', necklace:'项链' };
  return m[slot] || slot;
}
function renderEquip() {
  // 已装备区
  let eqHtml = '';
  for (const slot of EQUIP_SLOTS) {
    const item = S.equipped[slot];
    if (item) {
      const q = QUALITY[item.quality];
      const aff = (item.affixes||[]).map(a=>a.name).join('/');
      eqHtml += '<div class="eq-slot" style="border-color:'+q.color+'">'+
        '<span class="eq-emoji">'+item.emoji+'</span>'+
        '<span class="eq-name" style="color:'+q.color+'">'+item.name+(item.enhance?'+'+item.enhance:'')+'</span>'+
        (aff?'<span class="eq-aff">'+aff+'</span>':'')+
        '<button class="eq-btn" data-unequip="'+slot+'">卸</button></div>';
    } else {
      eqHtml += '<div class="eq-slot empty"><span class="eq-emoji">▢</span><span class="eq-name">'+slotLabel(slot)+'</span></div>';
    }
  }
  $('equippedSlots').innerHTML = eqHtml;
  // 背包区
  $('bagCount').textContent = S.equipBag.length + '/' + BAG_MAX;
  const bagEl = $('bagList');
  if (S.equipBag.length === 0) { bagEl.innerHTML = '<p class="empty-hint">击杀怪物掉落装备</p>'; return; }
  let bh = '';
  for (let i = 0; i < S.equipBag.length; i++) {
    const it = S.equipBag[i]; const q = QUALITY[it.quality];
    const aff = (it.affixes||[]).map(a=>a.name).join('/');
    bh += '<div class="bag-item" style="border-color:'+q.color+'">'+
      '<span class="bag-emoji">'+it.emoji+'</span>'+
      '<span class="bag-name" style="color:'+q.color+'">'+it.name+(it.enhance?'+'+it.enhance:'')+'</span>'+
      (aff?'<span class="bag-aff">['+aff+']</span>':'')+
      '<div class="bag-btns">'+
      '<button data-act="equip" data-idx="'+i+'">装</button>'+
      '<button data-act="enhance" data-idx="'+i+'">强化</button>'+
      '<button data-act="sell" data-idx="'+i+'">卖</button>'+
      '<button data-act="discard" data-idx="'+i+'">丢</button></div></div>';
  }
  bagEl.innerHTML = bh;
}

// ---------------- 技能/药剂渲染（M4） ----------------
function renderSkills() {
  // 被动技能
  let ph = '';
  const passives = S.skills.passives || [];
  if (passives.length === 0) {
    ph = '<p class="empty-hint">击杀怪物有概率获得技能书</p>';
  } else {
    for (const id of passives) {
      const ps = PASSIVE_SKILLS[id]; if (!ps) continue;
      ph += '<div class="skill-item passive"><span class="sk-emoji">' + ps.emoji + '</span><span class="sk-name">' + ps.name + '</span><span class="sk-desc">' + ps.desc + '</span></div>';
    }
  }
  $('passiveList').innerHTML = ph;
  // 主动技能
  let ah = '';
  for (const id of Object.keys(ACTIVE_SKILLS)) {
    const sk = ACTIVE_SKILLS[id];
    const cd = S.cds[id] || 0;
    const mpOk = (S.buffs.surge || 0) > 0 || sk.mp === 0 || S.life.curMP.gte(sk.mp);
    const disabled = cd > 0 || !mpOk || GAME_OVER;
    ah += '<button class="sk-btn' + (disabled?' disabled':'') + '" data-skill="' + id + '"' + (disabled?' disabled':'') + '>'
      + sk.emoji + ' ' + sk.name
      + (cd > 0 ? ' <span class="cd">' + Math.ceil(cd) + 's</span>' : '')
      + (sk.mp > 0 ? ' <span class="mp">' + sk.mp + '蓝</span>' : '')
      + '</button>';
  }
  $('activeList').innerHTML = ah;
  // 药剂
  let pt = '';
  for (const id of Object.keys(POTIONS)) {
    const pot = POTIONS[id];
    const stock = S.potions[id] || 0;
    pt += '<div class="pot-item">'
      + '<span class="pot-emoji">' + pot.emoji + '</span>'
      + '<span class="pot-name">' + pot.name + '</span>'
      + '<span class="pot-stock">×' + stock + '</span>'
      + '<button class="pot-btn use" data-potion="' + id + '" data-act="use"' + (stock<=0||GAME_OVER?' disabled':'') + '>用</button>'
      + '<button class="pot-btn buy" data-potion="' + id + '" data-act="buy"' + (GAME_OVER?' disabled':'') + '>买' + pot.price + '</button>'
      + '</div>';
  }
  $('potionList').innerHTML = pt;
}

// ---------------- 墓园渲染（M6） ----------------
function renderGraveyard() {
  const list = graveyardAll();
  const el = $('graveyardList');
  if (list.length === 0) { el.innerHTML = '<p class="empty-hint">墓园空荡荡，尚无人长眠</p>'; return; }
  let html = '';
  for (const g of list) {
    const isGold = g.type === 'rebirth';
    html += '<div class="grave-item' + (isGold?' gold':'') + '">'
      + (isGold?'🟡':'⚫') + ' ' + (g.name||'无名氏') + ' · 第' + g.gen + '世 · 存活' + (g.lived||'?')
      + ' · 定格' + (g.maxHP ? fmt(new Decimal(g.maxHP)) : '?') + '血'
      + (g.cause ? ' · 亡于' + g.cause : ' · 飞升')
      + (g.epitaph ? '<br><span class="epitaph">「' + g.epitaph + '」</span>' : '')
      + '</div>';
  }
  el.innerHTML = html;
}

// ---------------- DOM 快捷 ----------------
const $ = (id) => document.getElementById(id);

// ---------------- 渲染 ----------------
let lastMaxHPShown = '0';

const UI = {
  render(dt) {
    if (GAME_OVER) return;
    const p = getPanel();

    // 大数字跳动（+1 动画）
    const hpStr = fmt(p.maxHP);
    if (hpStr !== lastMaxHPShown) {
      $('hpMax').textContent = hpStr;
      pulse('hpMax');
      lastMaxHPShown = hpStr;
    }
    $('hpCur').textContent = fmt(p.curHP);
    $('hpBar').style.width = p.curHP.div(p.maxHP).times(100).toNumber().toFixed(1) + '%';
    $('mpCur').textContent = fmt(p.curMP);
    $('mpBar').style.width = p.curMP.div(p.MP).times(100).toNumber().toFixed(1) + '%';

    // 世代
    $('gen').textContent = '第 ' + S.gen + ' 世';
    // 赋能行
    const bl = Object.keys(S.blessings).map(k => k + '+' + (BLESS_STEP[k] * (1 + S.blessings[k].lv)) + '/拳').join(' · ');
    $('blessRow').textContent = '🧬 赋能: ' + bl;

    // 存档状态
    const gap = S.lastSaveTs ? Math.floor((Date.now() - S.lastSaveTs) / 60000) : -1;
    $('saveState').innerHTML = gap < 0
      ? '<span style="color:#e74c3c">⚠️ 从未存档</span>'
      : (gap === 0 ? '✅ 刚刚已存档' : '✅ ' + gap + ' 分钟前已存档（槽' + S.lastSaveSlot + '）');
    const unsafeGap = gap < 0 || gap > 5 || ZONES[S.zone].safe === false;
    $('saveState').className = unsafeGap && gap !== 0 ? 'savewarn' : 'saveok';

    // 属性面板
    $('stPATK').textContent = fmt(p.PATK);
    $('stMATK').textContent = fmt(p.MATK);
    $('stPDEF').textContent = fmt(p.PDEF);
    $('stMDEF').textContent = fmt(p.MDEF);
    $('stASPD').textContent = p.ASPD.toFixed(2) + '/s';
    $('stRNG').textContent = p.RNG.toFixed(1) + ' 步';
    $('stSPD').textContent = fmt(p.SPD);
    $('stCRIT').textContent = fmtPct(p.CRIT);
    $('stCRITD').textContent = p.CRITD.toFixed(2) + '×';
    $('stACC').textContent = fmtPct(p.ACC);
    $('stEVA').textContent = fmtPct(p.EVA);
    $('stREGEN').textContent = fmt(p.REGEN) + '/s';
    $('stGold').textContent = fmt(p.gold);

    // 统计
    $('stPunch').textContent = fmt(S.stats.punches);
    $('stKill').textContent = S.stats.kills;
    $('stLived').textContent = fmtDur(Date.now() - S.stats.born);

    // 战斗区
    const mob = S.mob;
    if (mob) {
      $('mobEmoji').textContent = mob.def.emoji;
      $('mobName').textContent = mob.def.name + (mob.def.maxHP === Infinity ? '（无限血）' : '');
      if (mob.def.maxHP === Infinity) {
        $('mobHp').textContent = '∞';
        $('mobBar').style.width = '100%';
      } else {
        $('mobHp').textContent = fmt(mob.curHP.max(0)) + ' / ' + mob.def.maxHP.toLocaleString('zh-CN');
        $('mobBar').style.width = (mob.curHP.div(mob.def.maxHP).times(100).max(0).toNumber().toFixed(1)) + '%';
      }
      $('mobDesc').textContent = mob.def.desc || '';
    }
    // 燃烧生命按钮
    const burnCd = S.cds.burn || 0;
    $('btnBurn').textContent = burnCd > 0
      ? '🔥 燃烧生命 (CD ' + Math.ceil(burnCd) + 's)'
      : '🔥 燃烧生命';
    $('btnBurn').disabled = burnCd > 0 || S.life.curHP.lte(S.life.maxHP.times(0.3));
    $('burnBuff').textContent = (S.buffs.burn || 0) > 0 ? '🔥 攻击翻倍中 ' + S.buffs.burn.toFixed(1) + 's' : '';

    // 区域名
    $('zoneName').textContent = ZONES[S.zone].emoji + ' ' + ZONES[S.zone].name;

    // M7: 飞升检测
    $('btnRebirth').style.display = checkRebirthReady() ? '' : 'none';

    // 地图按钮门槛禁用
    document.querySelectorAll('[data-zone]').forEach(btn => {
      const zid = btn.dataset.zone;
      const chk = checkZoneReq(zid);
      btn.classList.toggle('locked', !chk.ok);
      btn.disabled = !chk.ok && zid !== 'village';
    });
    // 装备区（M3）
    renderEquip();
    // 技能+药剂区（M4）
    renderSkills();
  },

  // ---------------- 死亡画面 ----------------
  showDeath(info) {
    const k = info.killer;
    $('deathKiller').textContent = k ? k.emoji + ' ' + k.name : '未知';
    $('deathHP').textContent = fmt(info.panel.maxHP);
    $('deathPunches').textContent = fmt(new Decimal(info.punches));
    $('deathLived').textContent = fmtDur(info.livedMs);
    const gapMin = S.lastSaveTs ? Math.floor((Date.now() - S.lastSaveTs) / 60000) : -1;
    $('deathSave').textContent = gapMin < 0 ? '你从未存过档' : '最近存档：' + gapMin + ' 分钟前（生命 ' + fmt(slotInfoHP()) + '）';
    $('btnLoadLast').style.display = S.lastSaveTs ? '' : 'none';
    // M5: 尸检报告
    if (info.analysis) {
      const a = info.analysis;
      let html = '📋 尸检：死因 ' + a.cause;
      if (a.physDmg > 0) html += '（物伤缺口 ' + a.physDmg + '）';
      if (a.magDmg > 0) html += '（魔伤缺口 ' + a.magDmg + '）';
      if (a.suggestions && a.suggestions.length) html += '<br>建议：' + a.suggestions.join('；');
      $('deathAutopsy').innerHTML = html;
    }
    $('deathMask').style.display = 'flex';
  },

  hideDeath() { $('deathMask').style.display = 'none'; }
};

function slotInfoHP() {
  // 读最近槽位面板（仅显示用）
  try {
    const best = loadLatestPreview();
    return best ? best : '?';
  } catch (e) { return '?'; }
}
function loadLatestPreview() {
  let bestTs = 0, hp = '?';
  for (let i = 0; i < 3; i++) {
    const raw = localStorage.getItem(SAVE_KEYS.slots[i]);
    if (!raw) continue;
    const o = JSON.parse(raw);
    if ((o.savedAt || 0) > bestTs) { bestTs = o.savedAt; hp = o.life ? o.life.maxHP : '?'; }
  }
  return hp;
}

// ---------------- 小工具 ----------------
function pulse(id) {
  const el = $(id);
  el.classList.remove('pulse');
  void el.offsetWidth;          // 重启动画
  el.classList.add('pulse');
}
function fmtDur(ms) {
  const m = Math.floor(ms / 60000), h = Math.floor(m / 60), d = Math.floor(h / 24);
  if (d > 0) return d + '天' + (h % 24) + '时';
  if (h > 0) return h + '时' + (m % 60) + '分';
  return m + '分';
}

// ---------------- 按钮绑定 ----------------
function bindUI() {
  // 地图
  document.querySelectorAll('[data-zone]').forEach(btn => {
    btn.addEventListener('click', () => {
      if (GAME_OVER) return;
      const zid = btn.dataset.zone;
      const ok = gotoZone(zid);              // 内部检查门槛，失败会 toast
      if (ok && zid !== 'village') {
        toast('⚠️ 进入 ' + ZONES[zid].name + '：战斗中不可存档，死亡只能回档');
      }
    });
  });
  $('btnBurn').addEventListener('click', () => castBurn());
  $('btnFlee').addEventListener('click', () => flee());

  // 装备操作（事件委托，背包内容动态）
  $('bagList').addEventListener('click', e => {
    const btn = e.target.closest('[data-act]'); if (!btn || GAME_OVER) return;
    const act = btn.dataset.act, idx = Number(btn.dataset.idx);
    let r = null;
    if (act === 'equip') r = equipItem(idx);
    else if (act === 'enhance') r = enhanceItem(idx);
    else if (act === 'sell') r = sellItem(idx);
    else if (act === 'discard') r = discardItem(idx);
    if (r) toast(r.msg);
  });
  $('equippedSlots').addEventListener('click', e => {
    const btn = e.target.closest('[data-unequip]'); if (!btn || GAME_OVER) return;
    toast(unequipItem(btn.dataset.unequip).msg);
  });

  // 主动技能（M4）
  $('activeList').addEventListener('click', e => {
    const btn = e.target.closest('[data-skill]'); if (!btn || GAME_OVER) return;
    const ok = castSkill(btn.dataset.skill);
    if (!ok) toast('无法施放（CD中/蓝不足/血不足）');
  });
  // 药剂（M4）
  $('potionList').addEventListener('click', e => {
    const btn = e.target.closest('[data-potion]'); if (!btn || GAME_OVER) return;
    const act = btn.dataset.act, id = btn.dataset.potion;
    toast((act === 'use' ? usePotion(id) : buyPotion(id)).msg);
  });

  // 墓园（M6）
  $('btnGraveyard').addEventListener('click', () => {
    renderGraveyard();
    $('graveyardMask').style.display = 'flex';
  });
  $('btnCloseGrave').addEventListener('click', () => { $('graveyardMask').style.display = 'none'; });

  // 飞升（M7）
  $('btnRebirth').addEventListener('click', () => {
    if (GAME_OVER) return;
    let html = '';
    for (const key of BLESS_ORDER) {
      const step = BLESS_STEP[key];
      const has = !!S.blessings[key];
      const label = has ? '强化 ' + key + '（步长升级）' : '新增 ' + key + '（+' + step + '/拳）';
      html += '<button class="rebirth-choice" data-bless="' + key + '">' + label + '</button>';
    }
    $('rebirthChoices').innerHTML = html;
    $('rebirthMask').style.display = 'flex';
  });
  $('rebirthChoices').addEventListener('click', e => {
    const btn = e.target.closest('[data-bless]'); if (!btn) return;
    const r = rebirth(btn.dataset.bless);
    $('rebirthMask').style.display = 'none';
    toast(r.msg);
  });

  // 存档
  document.querySelectorAll('[data-save]').forEach(btn =>
    btn.addEventListener('click', () => { toast(saveSlot(Number(btn.dataset.save)).msg); }));
  document.querySelectorAll('[data-load]').forEach(btn =>
    btn.addEventListener('click', () => { toast(loadSlot(Number(btn.dataset.load)).msg); }));

  // 导出导入
  $('btnExport').addEventListener('click', () => {
    const code = exportSave();
    $('ioText').value = code;
    $('ioText').select();
    toast('存档已生成，Ctrl+C 复制保存');
  });
  $('btnImport').addEventListener('click', () => {
    const t = $('ioText').value.trim();
    if (!t) return toast('先粘贴存档文本');
    toast(importSave(t).msg);
  });

  // 自动存档开关
  $('autoSaveChk').addEventListener('change', e => { S.autoSave = e.target.checked; });

  // 死亡画面
  $('btnLoadLast').addEventListener('click', () => {
    const r = loadLatest();
    if (r.ok) { UI.hideDeath(); toast(r.msg); } else toast(r.msg);
  });
  $('btnNewGame').addEventListener('click', () => {
    if (deathInfo) {
      const epitaph = $('deathEpitaph').value.trim() || '安息';
      graveyardAdd({
        name: '无名氏', gen: deathInfo.gen, lived: fmtDur(deathInfo.livedMs),
        maxHP: deathInfo.panel.maxHP.toString(), cause: deathInfo.killer ? deathInfo.killer.name : '未知',
        type: 'death', epitaph, ts: Date.now()
      });
      $('deathEpitaph').value = '';
    }
    newGame();
    UI.hideDeath();
    toast('第 0 世，重新来过');
  });
}

// ---------------- toast ----------------
function toast(msg) {
  const el = $('toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(el._t);
  el._t = setTimeout(() => el.classList.remove('show'), 2200);
}
